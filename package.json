{
  "name": "@flg1217/dsh-llm-agy",
  "version": "0.1.0",
  "description": "AGY (Antigravity CLI) integration for dsh: LLM adapter (subagents), web search provider (Google via search_web), and a plugin-settings card with install/login status checks, live connectivity test, multi-OS install commands, and tool reference. Hot-pluggable — mounted via profile bundle patch, no dsh source changes.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:portable": "node scripts/verify-portable.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:D:/Projects/DeepseekHarness/repo/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5",
    "@deepseek-ai/dsh-llm": "link:D:/Projects/DeepseekHarness/repo/packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:D:/Projects/DeepseekHarness/repo/packages/settings/settings",
    "@deepseek-ai/dsh-tools": "link:D:/Projects/DeepseekHarness/repo/packages/core/tools",
    "@deepseek-ai/dsh-subagent": "link:D:/Projects/DeepseekHarness/repo/packages/subagent/subagent",
    "@deepseek-ai/dsh-util-values": "link:D:/Projects/DeepseekHarness/repo/packages/util/values",
    "@deepseek-ai/dsh-session": "link:D:/Projects/DeepseekHarness/repo/packages/core/session",
    "@deepseek-ai/dsh-web": "link:D:/Projects/DeepseekHarness/repo/packages/web/web"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flg1217/dsh-llm-agy.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "antigravity",
    "agy",
    "gemini",
    "plugin"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}